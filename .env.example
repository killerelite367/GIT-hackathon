# Copy this file to .env and fill in what you need. .env is gitignored.

# ── Supabase (scaffolded, optional) ─────────────────────────────────────────
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── AI document scan ────────────────────────────────────────────────────────
# Pick ONE of the two modes below.
#
# Mode A — direct to Gemini (simplest; good for local dev and judging demos).
# Free key: https://aistudio.google.com -> Get API key.
#
#   WARNING: every VITE_* value is baked into the JS bundle at build time, so a
#   key set here is public on a deployed site. Prefer entering the key in the
#   app under Settings -> AI document scan (it stays in localStorage), or use
#   Mode B below.
VITE_GEMINI_API_KEY=

# Mode B — via n8n (keeps the key server-side; use this for a public deploy).
# Import n8n/studyquest-scan.json into n8n, set your Gemini credential there,
# activate the workflow, then paste its Production webhook URL here.
VITE_SCAN_WEBHOOK_URL=
